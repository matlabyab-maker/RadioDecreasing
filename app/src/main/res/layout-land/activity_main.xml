<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#06111D" android:padding="3dp">
  <!-- Compact header -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#0A2034" android:paddingHorizontal="6dp">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="◉ FAST RADIO" android:textColor="#7FD6FF" android:textSize="18sp" android:textStyle="bold" android:gravity="center_vertical"/>
    <TextView android:id="@+id/persianCalendar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="تقویم فارسی" android:textColor="#FFD43B" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:singleLine="true"/>
    <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Ready • Engine" android:textColor="#8BA6BC" android:textSize="11sp" android:gravity="center_vertical|end" android:singleLine="true"/>
  </LinearLayout>
  <!-- News tickers kept compact so the station lists remain the main area -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:orientation="vertical" android:background="#071C31" android:padding="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/tvReady" android:layout_width="14dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="9sp" android:gravity="center"/>
      <TextView android:id="@+id/tvTickerOriginal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="WORLD TV NEWS • Loading…" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center_vertical" android:singleLine="true"/>
      <TextView android:id="@+id/tvPersianReady" android:layout_width="14dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="9sp" android:gravity="center"/>
      <TextView android:id="@+id/tvTickerPersian" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ترجمه فارسی در حال آماده‌سازی…" android:textColor="#FFD43B" android:textSize="10sp" android:gravity="center_vertical" android:singleLine="true" android:textDirection="rtl"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:orientation="horizontal">
      <Button android:id="@+id/tvPrev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="TV ◀" android:textSize="7sp"/>
      <Button android:id="@+id/tvPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="PAUSE" android:textSize="7sp"/>
      <Button android:id="@+id/tvStop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="STOP" android:textSize="7sp"/>
      <Button android:id="@+id/tvNext" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="TV ▶" android:textSize="7sp"/>
      <TextView android:id="@+id/webReady" android:layout_width="14dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="9sp" android:gravity="center"/>
      <TextView android:id="@+id/webTickerTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="WEB NEWS" android:textColor="#7FD6FF" android:textSize="9sp" android:gravity="center_vertical" android:singleLine="true"/>
      <TextView android:id="@+id/webTickerText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:text="خبرهای وب‌سایت‌ها…" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center_vertical" android:singleLine="true"/>
      <Button android:id="@+id/webPrev" android:layout_width="34dp" android:layout_height="match_parent" android:background="@drawable/button_orange_selector" android:text="◀" android:textSize="7sp"/>
      <Button android:id="@+id/webPause" android:layout_width="42dp" android:layout_height="match_parent" android:background="@drawable/button_orange_selector" android:text="Ⅱ" android:textSize="7sp"/>
      <Button android:id="@+id/webStop" android:layout_width="36dp" android:layout_height="match_parent" android:background="@drawable/button_orange_selector" android:text="■" android:textSize="7sp"/>
      <Button android:id="@+id/webNext" android:layout_width="34dp" android:layout_height="match_parent" android:background="@drawable/button_orange_selector" android:text="▶" android:textSize="7sp"/>
    </LinearLayout>
  </LinearLayout>
  <!-- Compact live information strip -->
  <LinearLayout android:id="@+id/publicInfoTicker" android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:background="#071C31" android:padding="1dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="#0A2034" android:paddingHorizontal="3dp"><TextView android:id="@+id/iranReady" android:layout_width="12dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="8sp" android:gravity="center"/><TextView android:id="@+id/publicIran" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ایران • در حال دریافت…" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center_vertical" android:singleLine="true" android:textDirection="rtl"/></LinearLayout>
    <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#33495E"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="#0A2034" android:paddingHorizontal="3dp"><TextView android:id="@+id/worldReady" android:layout_width="12dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="8sp" android:gravity="center"/><TextView android:id="@+id/publicWorld" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="جهان • زمین‌لرزه…" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center_vertical" android:singleLine="true"/></LinearLayout>
    <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#33495E"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="#0A2034" android:paddingHorizontal="3dp"><TextView android:id="@+id/economyReady" android:layout_width="12dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="8sp" android:gravity="center"/><TextView android:id="@+id/publicEconomy" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="اقتصاد • در حال دریافت…" android:textColor="#FFB74D" android:textSize="9sp" android:gravity="center_vertical" android:singleLine="true" android:textDirection="rtl"/></LinearLayout>
  </LinearLayout>
  <!-- Main multi-column dashboard: the list windows are now the dominant area -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingTop="3dp">
    <!-- Left navigation / special news -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:orientation="vertical" android:background="#091B2C" android:padding="3dp">
      <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="SPECIAL NEWS" android:textColor="#FFD43B" android:textStyle="bold" android:textSize="10sp" android:gravity="center" android:background="#172A3C"/>
      <ListView android:id="@+id/newsList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/radio_list_bg" android:divider="#665D12" android:dividerHeight="1dp"/>
      <Button android:id="@+id/favorites" android:layout_width="match_parent" android:layout_height="30dp" android:background="@drawable/button_orange_selector" android:text="★ FAVORITES" android:textSize="9sp"/>
      <Button android:id="@+id/savedListsButton" android:layout_width="match_parent" android:layout_height="30dp" android:background="@drawable/button_orange_selector" android:text="SAVED LISTS" android:textSize="9sp"/>
      <Button android:id="@+id/importButton" android:layout_width="match_parent" android:layout_height="30dp" android:background="@drawable/button_orange_selector" android:text="IMPORT" android:textSize="9sp"/>
    </LinearLayout>
    <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#173A57"/>
    <!-- Custom station list -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.05" android:orientation="vertical" android:background="#071525" android:padding="3dp">
      <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="LIST 1 • CUSTOM RADIO" android:textColor="#39B9FF" android:textStyle="bold" android:textSize="10sp" android:gravity="center" android:background="#102A40"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"><Button android:id="@+id/customUp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_cyan_selector" android:text="▲" android:textSize="9sp"/><Button android:id="@+id/customDown" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_cyan_selector" android:text="▼" android:textSize="9sp"/></LinearLayout>
      <ListView android:id="@+id/customList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/radio_list_bg" android:divider="#173A57" android:dividerHeight="1dp"/>
      <Button android:id="@+id/saveList" android:layout_width="match_parent" android:layout_height="28dp" android:background="@drawable/button_green_selector" android:text="SAVE THIS LIST" android:textSize="9sp"/>
    </LinearLayout>
    <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#173A57"/>
    <!-- Iran stations -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.05" android:orientation="vertical" android:background="#071525" android:padding="3dp">
      <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="LIST 2 • IRAN RADIO" android:textColor="#65E6A5" android:textStyle="bold" android:textSize="10sp" android:gravity="center" android:background="#102A40"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"><Button android:id="@+id/iranUp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_green_selector" android:text="▲" android:textSize="9sp"/><Button android:id="@+id/iranDown" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_green_selector" android:text="▼" android:textSize="9sp"/></LinearLayout>
      <ListView android:id="@+id/iranList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/radio_list_bg" android:divider="#173A57" android:dividerHeight="1dp"/>
    </LinearLayout>
    <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#173A57"/>
    <!-- World stations and search controls -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:orientation="vertical" android:background="#071525" android:padding="3dp">
      <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="LIST 3 • WORLD RADIO" android:textColor="#7FD6FF" android:textStyle="bold" android:textSize="10sp" android:gravity="center" android:background="#102A40"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"><Spinner android:id="@+id/regionSpinner" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/><Spinner android:id="@+id/countrySpinner" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2"/></LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"><EditText android:id="@+id/search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="Search station / country" android:textColor="#FFFFFF" android:textColorHint="#71879C" android:textSize="10sp" android:singleLine="true"/><ImageButton android:id="@+id/searchButton" android:layout_width="34dp" android:layout_height="match_parent" android:src="@drawable/ic_search" android:contentDescription="جستجو" android:scaleType="centerInside" android:padding="4dp" android:background="@drawable/button_green_selector"/></LinearLayout>
      <ListView android:id="@+id/worldList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/radio_list_bg" android:divider="#173A57" android:dividerHeight="1dp"/>
    </LinearLayout>
    <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#173A57"/>
    <!-- Vertical bitrate ruler -->
    <LinearLayout android:layout_width="48dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:background="#06111D" android:padding="1dp">
      <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="kbps" android:textColor="#39B9FF" android:textStyle="bold" android:textSize="9sp" android:gravity="center"/>
      <com.fast.radio.VerticalRulerView android:id="@+id/qualityRuler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
      <TextView android:id="@+id/qualityValue" android:layout_width="match_parent" android:layout_height="28dp" android:text="15 kbps" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:gravity="center"/>
    </LinearLayout>
    <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#173A57"/>
    <!-- Right-side engine, buffer, usage and volume tools -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" android:orientation="vertical" android:background="#091B2C" android:padding="3dp">
      <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="ENGINE / BUFFER" android:textColor="#FFB74D" android:textStyle="bold" android:textSize="10sp" android:gravity="center" android:background="#172A3C"/>
      <TextView android:id="@+id/streamKbps" android:layout_width="match_parent" android:layout_height="24dp" android:text="Stream: -- kbps" android:textColor="#7FD6FF" android:textSize="9sp" android:gravity="center"/>
      <TextView android:id="@+id/usage12h" android:layout_width="match_parent" android:layout_height="22dp" android:text="12 ساعت: -- MB" android:textColor="#FFB74D" android:textSize="9sp" android:gravity="center"/>
      <TextView android:id="@+id/usagePerMinute" android:layout_width="match_parent" android:layout_height="30dp" android:text="0 KB/min • 0 MB/min" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center"/>
      <TextView android:id="@+id/usageTimer" android:layout_width="match_parent" android:layout_height="24dp" android:text="00:00" android:textColor="#FFB74D" android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
      <View android:id="@+id/usageLine" android:layout_width="match_parent" android:layout_height="5dp" android:background="#FF7A00"/>
      <TextView android:layout_width="match_parent" android:layout_height="20dp" android:text="VOLUME" android:textColor="#39B9FF" android:textStyle="bold" android:textSize="9sp" android:gravity="center"/>
      <com.fast.radio.VolumeRulerView android:id="@+id/volumeRuler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
  </LinearLayout>
  <!-- Persistent player / station information and recording controls -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#06111D" android:padding="3dp">
    <com.fast.radio.AudioDanceView android:id="@+id/audioDance" android:layout_width="38dp" android:layout_height="match_parent" android:padding="2dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="5dp"><TextView android:id="@+id/nowPlaying" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="No station selected" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end"/><TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="PLAYER • BUFFER STATUS" android:textColor="#8BA6BC" android:textSize="9sp" android:gravity="center_vertical"/><TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="Station information / stream engine" android:textColor="#39B9FF" android:textSize="9sp" android:gravity="center_vertical"/></LinearLayout>
    <FrameLayout android:layout_width="66dp" android:layout_height="match_parent"><Button android:id="@+id/play" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/button_outline_green" android:text="PLAY" android:textSize="10sp"/><View android:id="@+id/playLight" android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|end" android:layout_margin="4dp" android:background="#22CC44" android:visibility="gone"/></FrameLayout>
    <Button android:id="@+id/stop" android:layout_width="60dp" android:layout_height="match_parent" android:background="@drawable/button_outline_orange" android:text="STOP" android:textSize="10sp"/>
    <FrameLayout android:layout_width="72dp" android:layout_height="match_parent"><Button android:id="@+id/record" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/button_outline_red" android:text="REC" android:textSize="10sp"/><View android:id="@+id/recordLight" android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|end" android:layout_margin="4dp" android:background="#FF3333" android:visibility="gone"/></FrameLayout>
    <Button android:id="@+id/fav" android:layout_width="42dp" android:layout_height="match_parent" android:background="@drawable/button_outline_yellow" android:text="★" android:textSize="14sp"/>
  </LinearLayout>
  <FrameLayout android:layout_width="1dp" android:layout_height="1dp"><View android:id="@+id/equalizer" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/></FrameLayout>
</LinearLayout>
